PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/drivemyway

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate a strong secret for production: openssl rand -hex 64
JWT_SECRET=change-me-to-a-strong-secret-in-production
JWT_REFRESH_SECRET=change-me-too-use-different-secret

# Firebase Admin SDK
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# SMS (MSG91 for OTP fallback)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Feature flags
OTP_BYPASS_PHONES=+919999999999,+919888888888  # test numbers that skip OTP in dev
