# ═══════════════════════════════════════════════════════════════
# DriveMyWay — Production Environment Variables Reference
# ═══════════════════════════════════════════════════════════════
# Copy this to each service's .env file.
# Set actual values as Railway / Vercel environment variables —
# NEVER commit real secrets to git.
# ═══════════════════════════════════════════════════════════════

# ── Node ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001                         # Change per service: 3001/3002/3003/3004/3005

# ── Database ─────────────────────────────────────────────────────
# Railway PostgreSQL plugin sets DATABASE_URL automatically
DATABASE_URL=postgresql://user:pass@host:5432/drivemyway

# ── Redis ────────────────────────────────────────────────────────
# Railway Redis plugin sets REDIS_URL automatically
REDIS_URL=redis://default:pass@host:6379

# ── Auth / JWT ────────────────────────────────────────────────────
JWT_SECRET=min-64-char-random-secret-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Firebase (Auth + FCM) ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/secrets/firebase.json

# ── Razorpay (Payment) ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── MSG91 (SMS) ───────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID_GENERIC=your_template_id

# ── SendGrid (Email) ──────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@drivemyway.com

# ── Google Maps ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza_your_server_side_key

# ── Inter-service ─────────────────────────────────────────────────
INTERNAL_API_KEY=shared-internal-secret-min-32-chars
NOTIFICATION_SERVICE_URL=https://notify.drivemyway.up.railway.app
BOOKING_SERVICE_URL=https://booking.drivemyway.up.railway.app
TRACKING_SERVICE_URL=https://tracking.drivemyway.up.railway.app

# ── Family Tracker (Vercel) ───────────────────────────────────────
FAMILY_TRACKER_URL=https://track.drivemyway.com
ALLOWED_ORIGINS=https://drivemyway.com,https://track.drivemyway.com

# ── Ops ───────────────────────────────────────────────────────────
OPS_EMAIL=ops@drivemyway.com
